{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-to-eval.dev/schemas/v1/reliability-report.schema.json",
  "title": "Repeated-Run Reliability Report",
  "version": "1.0.0",
  "type": "object",
  "required": ["summary", "reports", "cases"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "object",
      "required": [
        "reports", "cases", "attempt_slots", "observed_attempts", "missing_attempts",
        "pass_at_1_cases", "pass_at_1_rate", "pass_at_k_cases", "pass_at_k_rate",
        "pass_all_k_cases", "pass_all_k_rate", "stable_cases", "stable_case_rate"
      ],
      "additionalProperties": false,
      "properties": {
        "reports": { "$ref": "#/$defs/non_negative_integer" },
        "cases": { "$ref": "#/$defs/non_negative_integer" },
        "attempt_slots": { "$ref": "#/$defs/non_negative_integer" },
        "observed_attempts": { "$ref": "#/$defs/non_negative_integer" },
        "missing_attempts": { "$ref": "#/$defs/non_negative_integer" },
        "pass_at_1_cases": { "$ref": "#/$defs/non_negative_integer" },
        "pass_at_1_rate": { "$ref": "#/$defs/rate" },
        "pass_at_k_cases": { "$ref": "#/$defs/non_negative_integer" },
        "pass_at_k_rate": { "$ref": "#/$defs/rate" },
        "pass_all_k_cases": { "$ref": "#/$defs/non_negative_integer" },
        "pass_all_k_rate": { "$ref": "#/$defs/rate" },
        "stable_cases": { "$ref": "#/$defs/non_negative_integer" },
        "stable_case_rate": { "$ref": "#/$defs/rate" }
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "non_negative_integer": { "type": "integer", "minimum": 0 },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "case": {
      "type": "object",
      "required": [
        "id", "suite", "attempts_expected", "attempts_observed", "pass_count",
        "pass_at_1", "pass_at_k", "pass_all_k", "stable", "attempts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "suite": { "type": "string", "minLength": 1 },
        "attempts_expected": { "$ref": "#/$defs/non_negative_integer" },
        "attempts_observed": { "$ref": "#/$defs/non_negative_integer" },
        "pass_count": { "$ref": "#/$defs/non_negative_integer" },
        "pass_at_1": { "type": "boolean" },
        "pass_at_k": { "type": "boolean" },
        "pass_all_k": { "type": "boolean" },
        "stable": { "type": "boolean" },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attempt" }
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["attempt", "report", "observed", "passed", "trace_id"],
      "additionalProperties": false,
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "report": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "trace_id": { "type": ["string", "null"] }
      }
    }
  }
}
