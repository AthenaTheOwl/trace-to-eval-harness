{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-to-eval.dev/schemas/v2-1/run-evidence.schema.json",
  "title": "Run Evidence Packet",
  "version": "2.1.0",
  "description": "Run evidence packet contract. Schema $id and version are bumped together; minor bumps (2.0 -> 2.1) add optional fields or relax patterns under anyOf; major bumps (2 -> 3) change required field shapes.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "producer_run_id",
    "run_record_ref",
    "run_record_hash",
    "event_log_ref",
    "event_log_hash",
    "generated_at",
    "runtime_provider",
    "input_refs",
    "tool_calls",
    "mcp_servers",
    "policy_decisions",
    "approval_events",
    "artifact_diffs",
    "gate_results",
    "trace_refs",
    "rollback_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Run identifier carried in the packet body. In v2 this equals producer_run_id; no synthesis."
    },
    "producer_run_id": {
      "type": "string",
      "minLength": 1,
      "description": "The run_id from the producer's emitted Run record. Always preserved from source; never synthesized."
    },
    "run_record_ref": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {"pattern": "^repo://[a-z][a-z0-9-]*@[a-f0-9]{40}/.+$"},
        {"pattern": "^[^\\s]+$"}
      ],
      "description": "Path or repo:// URI to producer Run record. repo:// preferred; local paths accepted for migration interop."
    },
    "run_record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex digest of the canonicalized Run record bytes (json.dumps with sort_keys=True, indent=2, ensure_ascii=False, then UTF-8 encode)."
    },
    "event_log_ref": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {"pattern": "^repo://[a-z][a-z0-9-]*@[a-f0-9]{40}/.+$"},
        {"pattern": "^[^\\s]+$"}
      ],
      "description": "Path or repo:// URI to the source event ledger JSONL. repo:// preferred; local paths accepted for migration interop."
    },
    "event_log_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex digest of the raw event log bytes (read in binary, hashed directly — no normalization, since the ledger is append-only)."
    },
    "prompt_snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Replay-equivalence hash cloned from producer Run record. Lets a packet consumer prove preconditions match a specific run without rehashing prompts."
    },
    "tool_schemas_snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Replay-equivalence hash cloned from producer Run record."
    },
    "sandbox_image_ref": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {"pattern": "^repo://[a-z][a-z0-9-]*@[a-f0-9]{40}/.*$"},
        {"pattern": "^[^\\s]+$"}
      ],
      "description": "Sandbox/worktree reference cloned from producer Run record. repo:// URI preferred (carries repo + commit SHA); free-form strings accepted for legacy producers."
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "Artifact kind tag (e.g. brief, packet, watchlist_risk_packet, eval_report)."
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "anyOf": [
              {"pattern": "^repo://[a-z][a-z0-9-]*@[a-f0-9]{40}/.+$"},
              {"pattern": "^artifact://[a-z][a-z0-9-]*/.+$"},
              {"pattern": "^[^\\s]+$"}
            ],
            "description": "Path, repo:// URI, or artifact:// URI pointing at the artifact. URI forms preferred; local paths accepted for migration interop."
          },
          "artifact_id": {
            "type": "string",
            "description": "Optional id from the Run record's outputs[]."
          }
        }
      },
      "description": "Artifacts the producing run wrote. Sourced from Run.outputs[]; consumers can resolve refs to inspect outputs."
    },
    "artifact_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "hash"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "description": "SHA-256 hashes per artifact ref. Resolves artifact_refs that point at on-disk paths; entries are omitted when the ref is unresolvable from this repo."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] }
      }
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ref" }
    },
    "tool_calls": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool_call" }
    },
    "mcp_servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/mcp_server" }
    },
    "policy_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/policy_decision" }
    },
    "approval_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/approval_event" }
    },
    "artifact_diffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_diff" }
    },
    "gate_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate_result" }
    },
    "cost_usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "$ref": "#/$defs/non_negative_number" },
        "output_tokens": { "$ref": "#/$defs/non_negative_number" },
        "total_tokens": { "$ref": "#/$defs/non_negative_number" },
        "estimated_cost_usd": { "$ref": "#/$defs/non_negative_number" }
      }
    },
    "trace_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" }
    },
    "rollback_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "non_negative_number": {
      "type": "number",
      "minimum": 0
    },
    "ref": {
      "type": "object",
      "required": ["kind", "uri"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "hash": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "tool_call": {
      "type": "object",
      "required": ["name", "decision"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "server": { "type": ["string", "null"] },
        "decision": {
          "type": "string",
          "enum": ["allowed", "denied", "approval-required", "unknown"]
        },
        "source_event_id": { "type": ["string", "null"] }
      }
    },
    "mcp_server": {
      "type": "object",
      "required": ["name", "decision"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "decision": {
          "type": "string",
          "enum": ["allowed", "denied", "approval-required", "unknown"]
        },
        "risk": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", "critical", "unknown", null]
        },
        "source_event_id": { "type": ["string", "null"] }
      }
    },
    "policy_decision": {
      "type": "object",
      "required": ["subject", "decision"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "decision": {
          "type": "string",
          "enum": ["allow", "deny", "human_approval_required", "unknown"]
        },
        "policy_id": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "source_event_id": { "type": ["string", "null"] }
      }
    },
    "approval_event": {
      "type": "object",
      "required": ["subject", "status"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["requested", "approved", "rejected", "expired", "unknown"]
        },
        "actor": { "type": ["string", "null"] },
        "source_event_id": { "type": ["string", "null"] }
      }
    },
    "artifact_diff": {
      "type": "object",
      "required": ["path", "change_type"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "change_type": {
          "type": "string",
          "enum": ["added", "modified", "deleted", "renamed", "unknown"]
        },
        "source_event_id": { "type": ["string", "null"] }
      }
    },
    "gate_result": {
      "type": "object",
      "required": ["name", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "warn", "skipped", "unknown"]
        },
        "summary": { "type": ["string", "null"] },
        "source_event_id": { "type": ["string", "null"] }
      }
    }
  }
}
